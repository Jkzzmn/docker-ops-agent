# Copy to .env on EACH backend machine. No user-specific absolute paths are required.
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FAST_MODEL=qwen3:4b-instruct
OLLAMA_QUALITY_MODEL=qwen3:8b
# Optional separate router. Must be installed; unset = FAST. Schema/transport failure escalates once to FAST.
# OLLAMA_ROUTER_MODEL=qwen3.5:2b
# OPENAI_ROUTER_MODEL=<your chosen router model>
MAX_REQUEST_SECONDS=60
MAX_MODEL_CALLS=8
MAX_TOOL_CALLS=24
READ_TOOL_CONCURRENCY=4
MODEL_CONCURRENCY=1
MAX_REPLANS=2
MAX_VALIDATION_ATTEMPTS=1
# Worker agents execute supervisor assignments without another planning LLM by default.
WORKER_REFINEMENT=0
# JSON 검토 요청의 context 크기. 파일 검토가 잘리면 모델 RAM 여유를 확인하고 조정하세요.
OLLAMA_NUM_CTX=8192
DOCKER_MODE=live
# If exactly one Compose project exists, it and its services are auto-detected.
# If several exist, the UI asks you to select one. These optional values set the startup default:
# COMPOSE_PROJECT_NAME=my-project
# DOCKER_PROJECT_DIR=/absolute/path/to/your-compose-project
# DOCKER_ALLOWED_SERVICES=backend,database
# Optional: an existing authenticated Docker context. Does NOT create remote access.
# DOCKER_CONTEXT=my-existing-context

# Verification after an approved restart polls Docker health for up to this many seconds (default 20).
# RECOVERY_WAIT_SECONDS=20
# 1 = keep every model prompt/response in the API response (for eval/example_run.py). Prompts can contain log excerpts.
# RECORD_LLM_IO=0

# Optional metadata-only LangSmith tracing: no query/history/files/tool arguments or model text.
# Requires BOTH the opt-in flag and a key. Never paste keys into chat or commit .env.
# Cloud delivery requires your own account; not exercised without a key.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=<your key>
# LANGSMITH_PROJECT=docker-ops-agent
